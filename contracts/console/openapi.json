  "components": {
    "schemas": {
      "ComparisonRequest": {
        "properties": {
          "run_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 6,
            "minItems": 2,
            "title": "Run Ids"
          }
        },
        "type": "object",
        "required": [
          "run_ids"
        ],
        "title": "ComparisonRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InferenceRequest": {
        "properties": {
          "deployment_id": {
            "type": "string",
            "title": "Deployment Id"
          },
          "expected_epoch": {
            "type": "string",
            "title": "Expected Epoch"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/Message"
            },
            "type": "array",
            "maxItems": 32,
            "minItems": 1,
            "title": "Messages"
          },
          "max_output_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Output Tokens",
            "default": 128
          },
          "deadline_ms": {
            "type": "integer",
            "maximum": 600000.0,
            "minimum": 1000.0,
            "title": "Deadline Ms",
            "default": 120000
          },
          "save_input": {
            "type": "boolean",
            "title": "Save Input",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "deployment_id",
          "expected_epoch",
          "messages"
        ],
        "title": "InferenceRequest"
      },
      "Login": {
        "properties": {
          "token": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Token"
          }
        },
        "type": "object",
        "required": [
          "token"
        ],
        "title": "Login"
      },
      "Message": {
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "system",
              "user",
              "assistant"
            ],
            "title": "Role"
          },
          "content": {
            "type": "string",
            "maxLength": 32768,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "role",
          "content"
        ],
        "title": "Message"
      },
      "Metrics": {
        "properties": {
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          },
          "runtime_first_token_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runtime First Token Ms"
          },
          "console_first_content_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Console First Content Ms"
          },
          "runtime_e2e_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Runtime E2E Ms"
          },
          "console_e2e_ms": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Console E2E Ms"
          },
          "decode_tail_tokens_per_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decode Tail Tokens Per S"
          },
          "measurement_profile": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measurement Profile"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "title": "Metrics"
      },
      "RunPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/RunRecord"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "next_offset": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Offset"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "next_offset"
        ],
        "title": "RunPage"
      },
      "RunRecord": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "load",
              "unload",
              "generate"
            ],
            "title": "Kind"
          },
          "state": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "cancel_requested",
              "completed",
              "cancelled",
              "failed",
              "timed_out",
              "interrupted"
            ],
            "title": "State"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          },
          "config": {
            "additionalProperties": true,
            "type": "object",
            "title": "Config"
          },
          "output": {
            "type": "string",
            "title": "Output"
          },
          "metrics": {
            "$ref": "#/components/schemas/Metrics"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "cleanup": {
            "type": "string",
            "title": "Cleanup"
          },
          "quality": {
            "type": "string",
            "title": "Quality"
          },
          "seq": {
            "type": "integer",
            "title": "Seq"
          }
        },
        "additionalProperties": true,
        "type": "object",
        "required": [
          "id",
          "kind",
          "state",
          "created_at",
          "updated_at",
          "config",
          "output",
          "metrics",
          "error",
          "cleanup",
          "quality",
          "seq"
        ],
        "title": "RunRecord"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
