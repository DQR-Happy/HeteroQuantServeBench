/models/
artifacts/
datasets/
checkpoints/
*.safetensors
*.gguf
*.onnx
*.engine
*.plan
*.pt
*.pth
*.bin

# Profiling files
*.ncu-rep
*.nsys-rep
*.qdrep

# Generated logs
*.log

# Raw transient benchmark data
benchmarks/raw/*
!benchmarks/raw/.gitkeep

# OS
.DS_Store
Thumbs.db

# Reports (top-level raw benchmark data only; docs/reports is documentation
# and MUST be tracked)
/reports/

# Scripts
/scripts/common/

# External third-party dependencies (fetched on demand; see third_party/README.md)
/third_party/cutlass/

# Docs
/docs
