*.qdrep

# Generated logs
*.log

# Raw transient benchmark data
benchmarks/raw/*
!benchmarks/raw/.gitkeep

# OS
.DS_Store
Thumbs.db

# Reports (top-level raw benchmark data only; docs/reports is documentation
# and MUST be tracked)
/reports/

# Scripts
/scripts/common/

# External third-party dependencies (fetched on demand; see third_party/README.md)
/third_party/cutlass/

# Docs: tracked documentation (architecture/reports/stages/templates).
# The stage-experiment protocol/report tree is internal evidence and stays out
# of the public repo (its raw run data already falls under /reports/ and
# /experiment_results/ ignores).
/docs/stage_experiments/

# Local CodeBuddy conversation exports (private; never publish)
/buddy_history/

# Codebuddy
.codebuddy/

# Codex
AGENTS.md
# S05 experiment run directories (raw execution data; local / archive separately)
/experiment_results/

/docs
