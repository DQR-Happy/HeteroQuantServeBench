*.qdrep

# Generated logs
*.log

# Raw transient benchmark data
benchmarks/raw/*
!benchmarks/raw/.gitkeep

# OS
.DS_Store
Thumbs.db

# Reports (top-level raw benchmark data only; docs/reports is documentation
# and MUST be tracked)
/reports/

# Scripts
/scripts/common/

# External third-party dependencies (fetched on demand; see third_party/README.md)
/third_party/cutlass/

# Docs: tracked documentation (architecture/reports/stages/templates).
# The stage-experiment protocol/report tree is internal evidence and stays out
# of the public repo (its raw run data already falls under /reports/ and
# /experiment_results/ ignores).
/docs/stage_experiments/

# Local CodeBuddy conversation exports (private; never publish)
/buddy_history/

# Codebuddy
.codebuddy/

# Codex
AGENTS.md
# S05 experiment run directories (raw execution data; local / archive separately)
/experiment_results/

# Docs: the published tree is limited to the documentation already tracked here.
# The internal audit / manual / working-architecture set (including validation
# screenshots and raw run output) stays local and must not be published.
# Do not link to ignored documents from tracked README files; assume any new
# file under docs/ is private until it is explicitly added.
/docs

# Private console state and frontend generated files
.console/
.venv-console/
node_modules/
*.tsbuildinfo
playwright-report/
test-results/

# Generated, self-contained gallery of private validation screenshots.
/web/console/public/preview.html

# Local snapshots taken before an explicitly requested redesign.
/.backups/

# Internal Notion sync dumps: private workspace page IDs, full page text and
# local absolute paths. Working notes only; never published.
/work/notion-sync/
