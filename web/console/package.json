{
  "name": "hqsb-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run src",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b",
    "format:check": "prettier --check src tests *.ts *.json index.html",
    "format": "prettier --write src tests *.ts *.json index.html",
    "api:generate": "openapi-typescript ../../contracts/console/openapi.json -o src/api/generated.ts"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@tanstack/react-query": "5.80.7",
    "antd": "5.26.2",
    "echarts": "6.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.15.30",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.5.2",
    "openapi-typescript": "7.8.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
